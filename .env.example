# Copy to .env and fill in real values. Never commit .env.
PORT=3000

# From https://api.slack.com/apps -> Your App -> Basic Information
SLACK_CLIENT_ID=YOUR_SLACK_APP_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_APP_CLIENT_SECRET
SLACK_SIGNING_SECRET=YOUR_SLACK_APP_SIGNING_SECRET

# Optional: secret used to sign the OAuth state parameter (CSRF protection).
SLACK_STATE_SECRET=

# Public HTTPS base URL of this server (no trailing slash).
# Slack redirect URL must be:   <PUBLIC_BASE_URL>/slack/oauth_redirect
# Slack Events request URL:     <PUBLIC_BASE_URL>/slack/events
PUBLIC_BASE_URL=https://your-production-domain.com

# WebSocket URL of your Buzz relay (NIP-29 managed relay, NIP-42 auth).
BUZZ_RELAY_URL=ws://buzz-relay:8080

# 32-byte (64 hex chars) master secret. Drives token encryption at rest,
# the bridge's Nostr identity, and per-user key derivation.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_MASTER_KEY=YOUR_64_CHAR_HEX_MASTER_KEY

# 'single' (default): one bridge identity signs all messages, attribution in
# message text. 'per-user': each Slack user gets a derived Nostr keypair —
# native attribution and deletions, but every derived pubkey must be allowed
# by your relay / added to the Buzz channel.
BRIDGE_KEY_MODE=single

# SQLite database location (created on first run).
BRIDGE_DB=./data/bridge.sqlite

# Optional but recommended once you know your clients' workspace IDs:
# comma-separated Slack team IDs allowed to install (e.g. T0123,T0456).
# Empty = anyone with your install link can connect their workspace.
# Installs from other teams are rejected and their tokens never stored.
SLACK_ALLOWED_TEAMS=
